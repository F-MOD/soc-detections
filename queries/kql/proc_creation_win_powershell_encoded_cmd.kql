DeviceProcessEvents
| where ((FolderPath endswith "\\powershell.exe" or FolderPath endswith "\\pwsh.exe") or (ProcessVersionInfoOriginalFileName in~ ("PowerShell.EXE", "pwsh.dll"))) and (ProcessCommandLine contains " -e " or ProcessCommandLine contains " -en" or ProcessCommandLine contains " -ec " or ProcessCommandLine contains " /e " or ProcessCommandLine contains " /en" or ProcessCommandLine contains " /ec ")
